// Embeds the engine manifest (UTF-8 code page, per-monitor DPI awareness): see engine.manifest.
1 24 "engine.manifest"
// The BuffrX icon (src-tauri/icons/icon.ico, drawn by tools/make-icon.ps1): the taskbar, the tray and the file.
1 ICON "icon.ico"

#include "../version.h"

// The file properties Windows shows in Task Manager and Explorer. The version comes from src/version.h, the
// same macro the engine reports on the wire, so the two cannot drift.
1 VERSIONINFO
FILEVERSION BUFFRX_VERSION_COMMA
PRODUCTVERSION BUFFRX_VERSION_COMMA
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "BuffrX"
      VALUE "FileDescription", "BuffrX engine"
      VALUE "FileVersion", BUFFRX_VERSION_DOTTED
      VALUE "InternalName", "buffrx-engine"
      VALUE "LegalCopyright", "GPL-2.0-or-later"
      VALUE "OriginalFilename", "buffrx-engine.exe"
      VALUE "ProductName", "BuffrX"
      VALUE "ProductVersion", BUFFRX_VERSION
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
