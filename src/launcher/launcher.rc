// The package entry carries the BuffrX icon (src-tauri/icons/icon.ico).
1 ICON "icon.ico"
// UTF-8 code page and long paths, so the launcher's A calls reach an install folder outside the system code page.
1 24 "launcher.manifest"

#include "../version.h"

// File properties for the entry point. The same version macro the engine reports, so Explorer and the app
// never show two different numbers.
1 VERSIONINFO
FILEVERSION BUFFRX_VERSION_COMMA
PRODUCTVERSION BUFFRX_VERSION_COMMA
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "BuffrX"
      VALUE "FileDescription", "BuffrX launcher"
      VALUE "FileVersion", BUFFRX_VERSION_DOTTED
      VALUE "InternalName", "BuffrX"
      VALUE "LegalCopyright", "GPL-2.0-or-later"
      VALUE "OriginalFilename", "BuffrX.exe"
      VALUE "ProductName", "BuffrX"
      VALUE "ProductVersion", BUFFRX_VERSION
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
